    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const configText = $json.config_text;\nlet prompt = $json.prompt_template;\n\n// Parse the simple .config file\nconst config = {};\n\nfor (const rawLine of configText.split('\\n')) {\n  const line = rawLine.trim();\n\n  if (!line || line.startsWith('[') || line.startsWith('#') || line.startsWith(';')) {\n    continue;\n  }\n\n  const separator = line.indexOf('=');\n  if (separator === -1) continue;\n\n  const key = line.slice(0, separator).trim().toLowerCase();\n  const value = line.slice(separator + 1).trim();\n\n  config[key] = value;\n}\n\n// Map config values to prompt placeholders\nconst replacements = {\n  OWNER: config.owner,\n  PRODUCT: config.product,\n  CATEGORY: config.category,\n  DEPLOYMENT: config.deployment,\n  COMPETITORS: config.competitors,\n};\n\nfor (const [key, value] of Object.entries(replacements)) {\n  prompt = prompt.split(`{{${key}}}`).join(value || '');\n}\n\n// First run: no previous dashboard JSON\nprompt = prompt.split('{{PREVIOUS_RUN_JSON}}').join('null');\n\nreturn {\n  json: {\n    research_prompt: prompt\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -96,
