    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = $json.text;\n\nif (!raw) {\n  throw new Error('No text field found in model output.');\n}\n\nconst cleaned = raw\n  .trim()\n  .replace(/^```json\\s*/i, '')\n  .replace(/^```\\s*/i, '')\n  .replace(/\\s*```$/, '');\n\nlet parsed;\n\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (error) {\n  throw new Error(\n    `Model output is not valid JSON: ${error.message}`\n  );\n}\n\nreturn {\n  json: parsed\n};"
      },
